function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const old = btn.textContent;
    btn.textContent = "copied";
    setTimeout(() => btn.textContent = old, 1000);
  });
}

function render(data) {
  resultsEl.innerHTML = "";
  if (data.errors && data.errors.length) {
    const errDiv = document.createElement("div");
    errDiv.className = "card";
    errDiv.innerHTML = "<strong style='color:var(--danger)'>Errors</strong><ul>" +
      data.errors.map(e => "<li>" + escapeHtml(e) + "</li>").join("") + "</ul>";
    resultsEl.appendChild(errDiv);
  }
  if (!data.hits || !data.hits.length) {
    const empty = document.createElement("div");
    empty.className = "card empty";
    empty.textContent = "No free / $0 / GWP matches found.";
    resultsEl.appendChild(empty);
    return;
  }

  // group by store → product
  const byStore = {};
  for (const h of data.hits) {
    (byStore[h.store] ||= []).push(h);
  }

  for (const [store, hits] of Object.entries(byStore)) {
