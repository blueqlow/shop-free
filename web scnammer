      card.innerHTML = `
        <h3>${badges.join("")}${escapeHtml(h0.title)}</h3>
        <div class="meta">
          <a href="${escapeAttr(h0.product_url)}" target="_blank" rel="noopener">${escapeHtml(h0.product_url)}</a><br/>
          Why: ${escapeHtml(h0.reason)}
          ${h0.tags && h0.tags.length ? " · Tags: " + escapeHtml(h0.tags.slice(0,10).join(", ")) : ""}
        </div>
        <table>
          <thead><tr><th>Variant ID</th><th>Variant</th><th>Price</th><th>SKU</th><th>Stock</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>`;
      resultsEl.appendChild(card);
    }
  }

  resultsEl.querySelectorAll("button.copy").forEach(btn => {
    btn.addEventListener("click", () => copyText(btn.dataset.copy, btn));
  });
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[c]);
}
function escapeAttr(s) {
  return escapeHtml(s).replace(/`/g, "&#96;");
}

scanBtn.addEventListener("click", async () => {
