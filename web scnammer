class Handler(BaseHTTPRequestHandler):
    server_version = "FreebieScanner/1.0"

    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("[%s] %s\n" % (self.log_date_time_string(), fmt % args))

    def _send(self, code: int, body: bytes, content_type: str = "text/html; charset=utf-8") -> None:
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        path = urlparse(self.path).path
        if path in ("/", "/index.html"):
            self._send(200, HTML_PAGE.encode("utf-8"))
            return
        if path == "/health":
            self._send(200, b'{"ok":true}', "application/json")
            return
        self._send(404, b"Not found")

    def do_POST(self) -> None:
        path = urlparse(self.path).path
        if path != "/api/scan":
            self._send(404, b'{"error":"not found"}', "application/json")
            return

        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(raw.decode("utf-8") or "{}")
        except json.JSONDecodeError:
            self._send(400, b'{"error":"invalid JSON"}', "application/json")
            return

        stores_raw = payload.get("stores") or []
        if isinstance(stores_raw, str):
            stores_raw = [stores_raw]
        strict = bool(payload.get("strict"))
        include_oos = bool(payload.get("include_oos"))
        loose = bool(payload.get("loose"))
        include_gift_cards = bool(payload.get("include_gift_cards"))

        stores = load_store_list([str(s) for s in stores_raw])
        if not stores:
            self._send(400, b'{"error":"no valid store URLs"}', "application/json")
            return

        # Cap to avoid abuse when exposed
        stores = stores[:15]

        all_hits: list = []
        errors: list[str] = []

        for s in stores:
            try:
                hits, err = scan_store(
                    s,
                    include_oos=include_oos,
                    include_gift_cards=include_gift_cards,
                    strict=strict,
                    loose=loose,
                )
                if err:
                    errors.append(err)
                all_hits.extend(hits)
            except Exception as e:  # noqa: BLE001
                errors.append(f"{s}: {e}")
                traceback.print_exc()

        # Serialize hits
        hits_out = []
        for h in all_hits:
            if hasattr(h, "__dataclass_fields__"):
                hits_out.append(asdict(h))
            else:
                hits_out.append(h)

        body = json.dumps(
            {"hits": hits_out, "errors": errors, "count": len(hits_out)},
            ensure_ascii=False,
        ).encode("utf-8")
        self._send(200, body, "application/json; charset=utf-8")


def main() -> None:
    httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    print("Shopify Freebie Scanner UI")
    print(f"Open → http://127.0.0.1:{PORT}")
    print(f"Bind  → {HOST}:{PORT}")
    print("Ctrl+C to stop")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
        httpd.server_close()


if __name__ == "__main__":
    main()
